filters:
  and:
    - file.inFolder("tasks")
    - file.name != "Overview"
formulas:
  name: 'file.asLink(if(title, title, file.basename))'
properties:
  formula.name:
    displayName: Task
  note.status:
    displayName: Status
  note.due:
    displayName: Due
  note.scheduled:
    displayName: Scheduled
  note.defer-until:
    displayName: Deferred Until
  note.projects:
    displayName: Project
  note.area:
    displayName: Area
  note.completed-at:
    displayName: Completed
  note.updated-at:
    displayName: Updated
views:
  - type: kanban
    name: Board
    filters:
      and:
        - '!file.inFolder("tasks/archive")'
        - not:
            - 'note["defer-until"] > today()'
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - inbox
      - ready
      - in-progress
      - blocked
      - done
    order:
      - formula.name
      - due
      - projects
      - area
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Today
    filters:
      and:
        - '!file.inFolder("tasks/archive")'
        - status != "done"
        - status != "dropped"
        - status != "icebox"
        - not:
            - 'note["defer-until"] > today()'
        - or:
            - status == "in-progress"
            - due <= today()
            - scheduled <= today()
            - 'note["defer-until"] >= today()'
    order:
      - formula.name
      - status
      - due
      - scheduled
      - projects
      - area
    sort:
      - property: due
        direction: ASC
      - property: scheduled
        direction: ASC
  - type: table
    name: Upcoming
    filters:
      and:
        - '!file.inFolder("tasks/archive")'
        - status != "done"
        - status != "dropped"
        - or:
            - 'due > today() && due <= today() + "14d"'
            - 'scheduled > today() && scheduled <= today() + "14d"'
            - 'note["defer-until"] > today() && note["defer-until"] <= today() + "14d"'
    order:
      - formula.name
      - status
      - due
      - scheduled
      - defer-until
      - projects
    sort:
      - property: due
        direction: ASC
      - property: scheduled
        direction: ASC
  - type: table
    name: Active
    filters:
      and:
        - '!file.inFolder("tasks/archive")'
        - status != "done"
        - status != "dropped"
        - status != "icebox"
        - not:
            - 'note["defer-until"] > today()'
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - in-progress
      - blocked
      - ready
      - inbox
    order:
      - formula.name
      - due
      - scheduled
      - projects
      - area
    sort:
      - property: due
        direction: ASC
  - type: table
    name: All
    order:
      - formula.name
      - status
      - due
      - projects
      - area
      - updated-at
    sort:
      - property: updated-at
        direction: DESC
  - type: table
    name: Linked Tasks
    filters:
      and:
        - file.hasLink(this.file)
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - in-progress
      - blocked
      - ready
      - inbox
      - icebox
      - done
      - dropped
    order:
      - formula.name
      - due
      - scheduled
      - completed-at
    sort:
      - property: due
        direction: ASC
