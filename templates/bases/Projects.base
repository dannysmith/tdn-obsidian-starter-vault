filters:
  and:
    - file.inFolder("projects")
    - file.name != "Overview"
properties:
  file.name:
    displayName: Project
  note.status:
    displayName: Status
  note.area:
    displayName: Area
  note.start-date:
    displayName: Started
  note.end-date:
    displayName: End Date
  note.description:
    displayName: Description
views:
  - type: kanban
    name: Board
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - planning
      - ready
      - in-progress
      - paused
      - blocked
      - done
    order:
      - file.name
      - area
      - end-date
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Active
    filters:
      or:
        - status == "in-progress"
        - status == "planning"
        - status == "ready"
    order:
      - file.name
      - status
      - area
      - end-date
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: All Projects
    order:
      - file.name
      - status
      - area
      - start-date
      - end-date
    sort:
      - property: status
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Linked Projects
    filters:
      and:
        - file.hasLink(this.file)
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - in-progress
      - planning
      - ready
      - paused
      - blocked
      - done
    order:
      - file.name
      - start-date
      - end-date
    sort:
      - property: file.name
        direction: ASC
